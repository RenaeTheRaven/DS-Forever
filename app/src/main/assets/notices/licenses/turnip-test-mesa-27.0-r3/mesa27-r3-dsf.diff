+      addr = nir_load_const_ir3(b, 2, 32, nir_imm_int(b, 0),
+                                .base = const_state->ubos[i].const_offset_vec4 * 4);
+   }
+
+   nir_def_replace(&intrin->def, addr);
+   return true;
+}
