+   if (ahb_usage_props) {
+      /* WN-Turnip: reaching here means the caller chained
+       * VkAndroidHardwareBufferUsageANDROID on the output, i.e. it is asking
+       * what to ALLOCATE with - the Android loader sizing up a swapchain
